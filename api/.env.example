APP_ENV=development
# 开发可用 SQLite；生产使用 PostgreSQL
DATABASE_URL=sqlite:///./tsumii.db
# DATABASE_URL=postgresql+psycopg://tsumii:tsumii@localhost:5432/tsumii
AUTO_CREATE_TABLES=true

# inline：请求内同步执行任务；rq：投递到 Redis，由 worker 执行
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379/0

# local 或 s3（MinIO / AWS S3 / Cloudflare R2）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=
S3_BUCKET=tsumii
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# mock：规则生成，无需密钥；bedrock：Amazon Bedrock 上的 Claude Haiku 5.5
AI_PROVIDER=mock
# Bedrock Converse API（IAM 权限 bedrock:InvokeModel）
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
AWS_REGION=us-east-1
# 非生产环境优先使用这里的静态凭证；不填或 APP_ENV=production 时使用 AWS 默认凭证链（~/.aws、SSO、IAM 角色等）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# sample：内置示例色卡（未核实）；db：python -m app.cli import-catalog 导入的已核实色卡
CATALOG_SOURCE=sample
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=12
# 可选：自定义 PDF 中文字体（TrueType）
PDF_FONT_PATH=
